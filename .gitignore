# Python environment and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Node.js and Frontend dependencies / build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
.npm/

# Temporary / Scratch artifacts
scratch/
.system_generated/
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Data files (keep gitkeeps and templates, do not commit large raw datasets)
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/templates/*.csv

# IDE and OS artifacts
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets, keys, and environment variables
.env
*.env
*.pem
*.key
