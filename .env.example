# Quality Intelligence — Configuration Environment Template
# Copy to .env for local adjustments. Never commit real credentials or .env files to version control.

# FastAPI Service Configuration
QI_API_HOST=0.0.0.0
QI_API_PORT=8000
QI_ENVIRONMENT=development
QI_DEBUG=false

# Allowed CORS Origins (comma-separated)
QI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Developer Integration & GitHub API (Optional, for live PR commentary)
# Leave unset to keep the system in offline / dry-run simulation mode.
GITHUB_TOKEN=
QI_DEFAULT_DRY_RUN=true
QI_REQUIRE_CONFIRMATION=true

# Model & Storage Paths
QI_MODEL_PATH=models/selected_model.joblib
QI_METADATA_PATH=models/model_metadata.json
QI_HISTORY_DIR=reports/history
